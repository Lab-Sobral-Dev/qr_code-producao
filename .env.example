# Segredo compartilhado do handshake de SSO com o Gestao SBR (Protocolo de
# Acoplamento). Deve ser identico ao configurado no lado do Gestao SBR para
# este produto. NUNCA commitar o valor real.
DOCKING_SECRET_QR_CODE_PRODUCAO=

# Segredo que assina a sessao local (cookie httpOnly) criada apos o handshake
# de SSO. Dedicado e separado do DOCKING_SECRET_QR_CODE_PRODUCAO: um autentica
# o handshake entre sistemas, o outro assina uma sessao que nunca sai deste
# app. NUNCA commitar o valor real.
SESSION_SECRET=

# Caminho do arquivo SQLite com os dados de alcool_registros (opcional,
# padrao ./data/banco.db). No Docker, aponte para um caminho dentro do
# volume persistente (ver Dockerfile) para o cadastro sobreviver a restarts.
DATABASE_PATH=

# URL e chave publica (anon/publishable) do projeto Supabase. Nao sao
# segredo -- ja estao hardcoded em app.js/consulta.js. So preencha aqui se o
# projeto Supabase mudar; o backend usa esses valores so para autenticar o
# login manual (Supabase Auth) e checar app_administradores, nunca para
# dado de negocio (alcool_registros vive no SQLite local, ver DATABASE_PATH).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Porta HTTP do servidor (opcional, padrao 3000).
PORT=3000
