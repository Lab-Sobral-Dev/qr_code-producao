# Segredo compartilhado do handshake de SSO com o Gestao SBR (Protocolo de
# Acoplamento). Deve ser identico ao configurado no lado do Gestao SBR para
# este produto. NUNCA commitar o valor real.
DOCKING_SECRET_QR_CODE_PRODUCAO=

# URL publica do projeto Supabase (nao e segredo, ja esta hardcoded em app.js).
SUPABASE_URL=https://deierwldemkevanfxrwg.supabase.co

# Service role key do Supabase (secret real, NUNCA commitar). Necessaria para
# auth.admin.generateLink e para o upsert em app_administradores durante o SSO.
SUPABASE_SERVICE_ROLE_KEY=

# Porta HTTP do servidor (opcional, padrao 3000).
PORT=3000
